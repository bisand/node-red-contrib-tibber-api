        "id": "a1f0c4d27b3e5a09",
        "type": "function",
        "z": "a1f0c4d27b3e5a01",
        "name": "First home",
        "func": "if (!msg.payload.length) {\n    node.warn('No homes found');\n    return null;\n}\nmsg.homeId = msg.payload[0].id;\nmsg.payload = { queryName: 'getDevices', homeId: msg.homeId };\nreturn msg;",
